<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The normal build is for Windows and includes the tray icon (Windows Forms).
       "dotnet build -p:Portable=true" builds for any system .NET runs on, without it. -->
  <PropertyGroup Condition="'$(Portable)' != 'true'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- A windowed program: opening Traceline must not show a console window. See ParentConsole.cs. -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Drawn by build\make-icon.ps1. -->
    <ApplicationIcon>Assets\traceline.ico</ApplicationIcon>
    <!-- The WebView2 package also references its WPF control, which this Windows Forms program does not use. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- Keeps the package's documentation files (*.xml) out of the published folder. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Portable)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Traceline</AssemblyName>
    <RootNamespace>Traceline.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Server GC keeps a lot of memory for a small background tool. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Traceline.Core\Traceline.Core.csproj" />
  </ItemGroup>

  <!-- The user guide travels inside the program, for the Help page (GET /api/guide). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\USER-GUIDE.md" LogicalName="USER-GUIDE.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>

  <!-- Traceline's own window shows the web UI in the WebView2 control (the runtime is part of Windows 11 and Edge). -->
  <ItemGroup Condition="'$(Portable)' != 'true'">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

</Project>
